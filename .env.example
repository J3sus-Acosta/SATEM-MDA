# Entorno de ejecución y puerto
NODE_ENV=development
PORT=4000

# Base de datos PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/satem_helpdesk?schema=public"

# Claves criptográficas JWT (Mínimo 32 caracteres aleatorios en producción)
JWT_SECRET=your-secure-jwt-secret-at-least-32-characters-long
JWT_REFRESH_SECRET=your-secure-refresh-jwt-secret-at-least-32-characters

# Orígenes CORS permitidos
CORS_ORIGIN=http://localhost:3000
