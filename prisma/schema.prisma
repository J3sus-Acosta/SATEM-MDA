generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  ON_HOLD
  SOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketType {
  INCIDENT
  SERVICE_REQUEST
  PROBLEM
  CHANGE
}

enum MessageType {
  PUBLIC_REPLY
  INTERNAL_NOTE
}

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  SUPPORT_SUPERVISOR
  SUPPORT_AGENT
  REQUESTER
}

model Tenant {
  id               String                @id @default(uuid())
  name             String
  slug             String                @unique
  subdomain        String?               @unique
  customDomain     String?               @unique
  logoUrl          String?
  timezone         String                @default("America/Santiago")
  plan             String                @default("ENTERPRISE")
  maxAgents        Int                   @default(15)
  maxMonthlyTickets Int                  @default(5000)
  maxStorageMb     Int                   @default(10240)
  isActive         Boolean               @default(true)
  settings         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  users            User[]
  tickets          Ticket[]
  groups           Group[]
  slaPolicies      SlaPolicy[]
  businessHours    BusinessHours[]
  workflowRules    WorkflowRule[]
  macros           Macro[]
  auditLogs        AuditLog[]
  webhooks         WebhookSubscription[]

  @@index([slug])
  @@index([isActive])
}

model User {
  id               String          @id @default(uuid())
  tenantId         String
  email            String
  passwordHash     String
  fullName         String
  avatarUrl        String?
  role             UserRole        @default(REQUESTER)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requestedTickets Ticket[]        @relation("RequestedTickets")
  assignedTickets  Ticket[]        @relation("AssignedTickets")
  messages         TicketMessage[]
  groupMemberships GroupMember[]
  auditLogs        AuditLog[]
  refreshTokens    RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  familyId  String
  isRevoked Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  permissions Permission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   @unique
  resource    String
  description String?
  roles       Role[]
}

model Group {
  id          String        @id @default(uuid())
  tenantId    String
  name        String
  description String?
  routingType String        @default("ROUND_ROBIN") // ROUND_ROBIN, LEAST_LOAD
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  tickets     Ticket[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model GroupMember {
  id        String   @id @default(uuid())
  groupId   String
  userId    String
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([groupId])
  @@index([userId])
}

model Ticket {
  id              String            @id @default(uuid())
  tenantId        String
  ticketCode      String
  title           String
  description     String
  status          TicketStatus      @default(NEW)
  priority        TicketPriority    @default(MEDIUM)
  type            TicketType        @default(INCIDENT)
  sourceChannel   String            @default("PORTAL") // PORTAL, EMAIL, API
  requesterId     String
  assigneeId      String?
  groupId         String?
  slaPolicyId     String?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  isSlaPaused        Boolean        @default(false)
  slaPausedAt        DateTime?
  totalSlaPausedMins Int            @default(0)
  tags               String[]       @default([])
  customFields       Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  requester       User              @relation("RequestedTickets", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee        User?             @relation("AssignedTickets", fields: [assigneeId], references: [id], onDelete: SetNull)
  group           Group?            @relation(fields: [groupId], references: [id], onDelete: SetNull)
  slaPolicy       SlaPolicy?        @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
  messages        TicketMessage[]
  attachments     TicketAttachment[]
  auditLogs       AuditLog[]

  @@unique([tenantId, ticketCode])
  @@index([tenantId, status])
  @@index([tenantId, priority])
  @@index([tenantId, requesterId])
  @@index([tenantId, assigneeId])
  @@index([tenantId, createdAt])
}

model TicketMessage {
  id          String             @id @default(uuid())
  ticketId    String
  authorId    String
  type        MessageType        @default(PUBLIC_REPLY)
  body        String
  isHtml      Boolean            @default(true)
  inReplyTo   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author      User               @relation(fields: [authorId], references: [id], onDelete: Restrict)
  attachments TicketAttachment[]

  @@index([ticketId, createdAt])
  @@index([ticketId, type])
}

model TicketAttachment {
  id          String         @id @default(uuid())
  ticketId    String
  messageId   String?
  fileName    String
  fileSize    Int
  mimeType    String
  storageKey  String
  hashSha256  String?
  createdAt   DateTime       @default(now())

  ticket      Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message     TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
}

model SlaPolicy {
  id              String         @id @default(uuid())
  tenantId        String
  name            String
  description     String?
  businessHoursId String?
  isDefault       Boolean        @default(false)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  businessHours   BusinessHours? @relation(fields: [businessHoursId], references: [id], onDelete: SetNull)
  targets         SlaTarget[]
  tickets         Ticket[]

  @@index([tenantId, isDefault])
}

model SlaTarget {
  id                 String         @id @default(uuid())
  slaPolicyId        String
  priority           TicketPriority
  firstResponseMins  Int
  resolutionMins     Int
  warningThresholdPct Int           @default(80)

  slaPolicy          SlaPolicy      @relation(fields: [slaPolicyId], references: [id], onDelete: Cascade)

  @@unique([slaPolicyId, priority])
}

model BusinessHours {
  id          String      @id @default(uuid())
  tenantId    String
  name        String
  timezone    String      @default("America/Santiago")
  weeklySchedule Json     // e.g. [{"day": 1, "start": "09:00", "end": "18:00"}, ...]
  holidays    Json?       // e.g. ["2026-01-01", "2026-05-01"]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  slaPolicies SlaPolicy[]

  @@index([tenantId])
}

model WorkflowRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  eventType   String   // TICKET_CREATED, TICKET_UPDATED, SLA_BREACHED
  conditions  Json     // Conditions tree e.g. { "all": [{ "field": "priority", "operator": "eq", "value": "URGENT" }] }
  actions     Json     // Action list e.g. [{ "type": "ASSIGN_GROUP", "groupId": "..." }]
  isActive    Boolean  @default(true)
  executionOrder Int   @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType, isActive])
}

model Macro {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  actions     Json     // [{ "type": "INSERT_REPLY", "text": "..." }, { "type": "SET_STATUS", "status": "PENDING" }]
  isShared    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String
  userId      String?
  ticketId    String?
  action      String   // CREATE, UPDATE, DELETE, LOGIN, EXPORT
  entity      String   // Ticket, User, SlaPolicy, etc.
  entityId    String
  ipAddress   String?
  userAgent   String?
  changesDiff Json?    // { "status": { "old": "OPEN", "new": "SOLVED" } }
  createdAt   DateTime @default(now())

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ticket      Ticket?  @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, entity, entityId])
  @@index([tenantId, userId])
}

model WebhookSubscription {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  targetUrl   String
  secretKey   String
  events      String[] // ["ticket.created", "ticket.updated"]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
}
